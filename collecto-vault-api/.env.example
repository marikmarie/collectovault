ENV_TYPE=production

# Browser origins allowed to call this API (comma-separated). Use the exact
# hosted Vault URL(s) in production. * is acceptable only during development.
CORS_ALLOWED_ORIGINS=https://your-vault-web.example

# Collecto merchant API
COLLECTO_BASE_URL=https://your-collecto-api.example
COLLECTO_API_KEY=replace_with_collecto_api_key

# Vault database
VAULT_DB=127.0.0.1
VAULT_DB_PORT=3306
VAULT_DB_USER=replace_with_database_user
VAULT_DB_PASS=replace_with_database_password
VAULT_DB_NAME=collecto_vault

# CissyTech Payments: server-to-server only. Generate the key in the Payments
# dashboard, and never expose either value in Vite or Expo public variables.
PEGASUS_CARD_API_BASE_URL=https://collecto.cissytech.com
PEGASUS_CARD_API_KEY=plk_test_replace_with_payments_api_key
