# Public API and browser access
APP_ENV=production
CORS_ALLOWED_ORIGINS=https://vault.example.com

# Collecto merchant API (server-side only)
COLLECTO_BASE_URL=https://your-collecto-api.example
COLLECTO_API_KEY=replace_with_collecto_api_key

# CissyTech Payments / Pegasus (server-side only)
PEGASUS_CARD_API_BASE_URL=https://payments.example.com
PEGASUS_CARD_API_KEY=plk_live_replace_with_payments_api_key

# MySQL database used by feedback, support contacts, chat, ratings, and card-payment idempotency
VAULT_DB_HOST=127.0.0.1
VAULT_DB_PORT=3306
VAULT_DB_NAME=collecto_vault
VAULT_DB_USER=replace_with_database_user
VAULT_DB_PASS=replace_with_database_password
